# ---- LLM backend -------------------------------------------------------------
# Any OpenAI-compatible endpoint works. Defaults target Groq (fast, follows JSON instructions well).
#   Groq      : https://api.groq.com/openai/v1        model e.g. openai/gpt-oss-120b
#   OpenAI    : https://api.openai.com/v1             model e.g. gpt-4o-mini
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama    : http://localhost:11434/v1             model e.g. qwen2.5:7b-instruct
SECOPS_LLM_BASE_URL=https://api.groq.com/openai/v1
SECOPS_LLM_MODEL=openai/gpt-oss-120b
SECOPS_LLM_API_KEY=            # required unless you point BASE_URL at local Ollama
SECOPS_LLM_TIMEOUT_S=60
SECOPS_LLM_MAX_RETRIES=3
SECOPS_LLM_TEMPERATURE=0.2

# ---- agent budgets ----------------------------------------------------------
SECOPS_MAX_STEPS=12
SECOPS_MAX_TOOL_FAILURES=3
SECOPS_MAX_OBSERVATION_CHARS=1200

# ---- behaviour --------------------------------------------------------------
# auto_approve=false => the agent must ask for human approval before irreversible actions
SECOPS_AUTO_APPROVE=false
# Demo aid: force a tool to fail, e.g. "list_findings:timeout@1" (fail the 1st call of that tool)
SECOPS_INJECT_FAULT=
